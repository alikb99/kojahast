---
import "../styles/global.css";
import SEO, { type SeoProps } from "../components/SEO.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";

type Props = { seo: SeoProps };
const { seo } = Astro.props;
---

<!doctype html>
<html lang="fa" dir="rtl">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#2f8a24" />
    <meta name="format-detection" content="telephone=no" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/images/logo.png" />
    <link rel="preload" href="/fonts/Vazir-Medium.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/fonts/Vazir-Black.woff2" as="font" type="font/woff2" crossorigin />
    <SEO {...seo} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">پرش به محتوای اصلی</a>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
  </body>
</html>
