---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import { SITE } from "../data/site";
import { getPosts } from "../lib/posts";
import { organization, website, webPage, breadcrumb, graph, type Crumb } from "../lib/schema";
import { fa, postUrl } from "../lib/utils";

const posts = await getPosts();
const totalCenters = posts.reduce((n, p) => n + p.data.centers.length, 0);
const mobilePillar = posts.find((p) => p.data.pillar && p.data.category === "mobile-repairs");
const laptopPillar = posts.find((p) => p.data.pillar && p.data.category === "laptop-and-computer-repair");

const url = "/about/";
const crumbs: Crumb[] = [
  { name: "خانه", url: "/" },
  { name: "درباره ما", url },
];

const method = [
  { icon: "lucide:search", title: "پیدا کردن مراکز", text: "برای هر برند یا خدمت، مراکز فعال تهران را از نقشه ها، دایرکتوری های معتبر، سایت و شبکه های اجتماعی خود مراکز و پیشنهاد کاربران پیدا می کنیم." },
  { icon: "lucide:badge-check", title: "تطبیق اطلاعات", text: "آدرس، تلفن و ساعت کاری را از حداقل دو منبع تطبیق می دهیم. اطلاعاتی که تأیید نشود منتشر نمی شود؛ جای خالی بهتر از شماره اشتباه است." },
  { icon: "lucide:thumbs-down", title: "نوشتن نقاط ضعف", text: "برای هر مرکز، کنار خدمات و مزایا، محدودیت ها را هم می نویسیم: ساعت کاری کوتاه، نبود پارکینگ، هزینه بالاتر از میانگین یا تمرکز روی برند خاص." },
  { icon: "lucide:calendar", title: "بروزرسانی مداوم", text: "راهنماها به صورت دوره ای بازبینی می شوند و تاریخ آخرین بروزرسانی بالای هر صفحه درج شده است. گزارش کاربران در اولویت بررسی است." },
];

const seo = {
  title: "درباره کجا هست | روش بررسی و معرفی مراکز",
  description: "کجا هست چطور مراکز تعمیر تهران را پیدا، بررسی و معرفی می کند؟ با روش کار، اصول بی طرفی و راه گزارش اطلاعات نادرست آشنا شوید.",
  path: url,
  jsonLd: graph(
    organization(),
    website(),
    webPage({ url, name: "درباره کجا هست", description: SITE.description, type: "AboutPage", hasBreadcrumb: true }),
    breadcrumb(url, crumbs)
  ),
};
---

<BaseLayout seo={seo}>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>درباره کجا هست</h1>
      <p class="lead">
        کجا هست از یک دردسر ساده شروع شد: گوشی خراب شده و نمی دانی به کدام تعمیرگاه اعتماد کنی. حالا برای هر برند یک راهنمای
        مقایسه ای داریم؛ تا امروز {fa(posts.length)} راهنما و {fa(totalCenters)} مرکز در تهران.
      </p>
    </div>
  </header>

  <section class="section">
    <div class="container about">
      <div class="prose">
        <h2>چه کاری انجام می دهیم</h2>
        <p>
          ما تعمیرگاه نیستیم و از هیچ مرکزی برای «بهترین» نامیدنش پول نمی گیریم. کارمان این است که اطلاعات پراکنده را یک جا و
          قابل مقایسه کنیم: هر راهنما با جدولی از نام، منطقه، تلفن، ساعت کاری و تخصص مراکز شروع می شود و بعد، هر مرکز را با خدمات،
          نقاط قوت و ضعف و راه های ارتباطی بررسی می کند.
        </p>
        <p>
          اگر نمی دانید از کجا شروع کنید، <a href={mobilePillar ? postUrl(mobilePillar.id) : "/blog/"}>راهنمای جامع تعمیرات موبایل تهران</a> و
          <a href={laptopPillar ? postUrl(laptopPillar.id) : "/blog/"}>راهنمای جامع تعمیر لپ تاپ در تهران</a> نقطه شروع خوبی هستند.
        </p>
        <h2>اصول ما</h2>
        <ul>
          <li><strong>بی طرفی:</strong> ترتیب مراکز در لیست رتبه بندی نیست و نقاط ضعف همه مراکز، از جمله همکارانمان، نوشته می شود.</li>
          <li><strong>دقت به جای حجم:</strong> مرکزی که آدرس و تلفنش تأیید نشود، وارد لیست نمی شود.</li>
          <li><strong>شفافیت:</strong> تاریخ بروزرسانی هر راهنما مشخص است و راه گزارش خطا همیشه باز است.</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="section section--soft" id="method" aria-labelledby="method-title">
    <div class="container">
      <div class="section-head">
        <h2 id="method-title">روش بررسی مراکز</h2>
        <p>هر مرکزی که در کجا هست می بینید، از این چهار مرحله گذشته است.</p>
      </div>
      <ol class="method">
        {method.map((m, i) => (
          <li class="card">
            <span class="method__icon"><Icon name={m.icon} /></span>
            <h3>{fa(i + 1)}. {m.title}</h3>
            <p>{m.text}</p>
          </li>
        ))}
      </ol>
      <div class="u-center mt-lg">
        <a class="btn btn--brand" href="/contact/">گزارش اطلاعات نادرست</a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .about { max-width: 820px; }
  .about .prose h2:first-child { margin-top: 0; }
  #method { scroll-margin-top: var(--header-h); }
  .method { list-style: none; padding: 0; margin: 0; display: grid; gap: 16px; }
  @media (min-width: 768px) { .method { grid-template-columns: repeat(2, 1fr); } }
  @media (min-width: 1100px) { .method { grid-template-columns: repeat(4, 1fr); } }
  .method li { padding: 20px; display: grid; gap: 8px; align-content: start; }
  .method__icon { width: 48px; height: 48px; border-radius: 50%; background: var(--brand-50); color: var(--brand-600); display: grid; place-items: center; }
  .method__icon :global(svg) { width: 24px; height: 24px; }
  .method h3 { font-size: 1.02rem; }
  .method p { font-size: .9rem; color: var(--ink-2); line-height: 2; }
</style>
