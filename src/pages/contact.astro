---
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Breadcrumbs from "../components/Breadcrumbs.astro";
import FaqList from "../components/FaqList.astro";
import { SITE } from "../data/site";
import { organization, website, webPage, breadcrumb, faqPage, graph, type Crumb } from "../lib/schema";
import { telHref } from "../lib/utils";

const url = "/contact/";
const crumbs: Crumb[] = [
  { name: "خانه", url: "/" },
  { name: "تماس با ما", url },
];

const topics = [
  { key: "add-business", label: "ثبت کسب‌وکار در کجا هست" },
  { key: "fix", label: "گزارش اطلاعات نادرست یک مرکز" },
  { key: "advice", label: "مشاوره برای انتخاب تعمیرگاه" },
  { key: "ads", label: "همکاری و تبلیغات" },
  { key: "other", label: "سایر موارد" },
];

const faqs = [
  { q: "چقدر طول می‌کشد پاسخ بدهید؟", a: "معمولاً تا یک روز کاری. گزارش اطلاعات نادرست و درخواست‌های ثبت کسب‌وکار به ترتیب رسیدن بررسی می‌شوند." },
  { q: "ثبت کسب‌وکار هزینه دارد؟", a: "ثبت اولیه در راهنمای مرتبط رایگان است. قبل از انتشار، اطلاعات شما را بررسی و در صورت نیاز تلفنی تأیید می‌کنیم." },
  { q: "برای اصلاح اطلاعات یک مرکز چه بفرستم؟", a: "لینک صفحه راهنما، نام مرکز و اطلاعات درست (مثلاً شماره یا آدرس جدید). اگر منبعی مثل صفحه اینستاگرام مرکز دارید، آن را هم بفرستید." },
];

const seo = {
  title: "تماس با کجا هست | ثبت کسب‌وکار و گزارش اطلاعات",
  description: "با کجا هست تماس بگیرید: ثبت رایگان کسب‌وکار، گزارش اطلاعات نادرست مراکز یا مشاوره برای انتخاب تعمیرگاه مناسب در تهران.",
  path: url,
  jsonLd: graph(
    organization(),
    website(),
    webPage({ url, name: "تماس با کجا هست", description: "راه‌های ارتباط با کجا هست", type: "ContactPage", hasBreadcrumb: true }),
    breadcrumb(url, crumbs),
    faqPage(url, faqs)
  ),
};
---

<BaseLayout seo={seo}>
  <header class="page-hero">
    <div class="container">
      <Breadcrumbs items={crumbs} />
      <h1>تماس با کجا هست</h1>
      <p class="lead">برای ثبت کسب‌وکار، گزارش اطلاعات نادرست یک مرکز یا مشاوره برای انتخاب تعمیرگاه، از یکی از راه‌های زیر با ما در ارتباط باشید.</p>
    </div>
  </header>

  <section class="section">
    <div class="container contact">
      <div class="contact__cards">
        <a class="c-card" href={telHref(SITE.phone)}>
          <Icon name="lucide:phone" />
          <span>تلفن پشتیبانی</span>
          <strong class="ltr">{SITE.phoneDisplay}</strong>
        </a>
        <a class="c-card" href={`mailto:${SITE.email}`}>
          <Icon name="lucide:mail" />
          <span>ایمیل</span>
          <strong class="ltr">{SITE.email}</strong>
        </a>
        <div class="c-card">
          <Icon name="lucide:clock" />
          <span>ساعت پاسخگویی</span>
          <strong>{SITE.hours}</strong>
        </div>
        <div class="c-card">
          <Icon name="lucide:map-pin" />
          <span>آدرس</span>
          <strong>{SITE.address}</strong>
        </div>
      </div>

      <div class="card contact__form" id="add-business">
        <h2>ارسال پیام</h2>
        <p class="muted">بعد از زدن دکمه ارسال، برنامه ایمیل شما با متن آماده باز می‌شود.</p>
        <form data-mailto={SITE.email}>
          <div class="f-row">
            <label>
              <span>نام شما</span>
              <input name="name" required autocomplete="name" />
            </label>
            <label>
              <span>شماره تماس</span>
              <input name="phone" type="tel" inputmode="tel" dir="ltr" autocomplete="tel" />
            </label>
          </div>
          <label>
            <span>موضوع</span>
            <select name="topic" required>
              {topics.map((t, i) => <option value={t.label} selected={i === 0}>{t.label}</option>)}
            </select>
          </label>
          <label>
            <span>متن پیام</span>
            <textarea name="message" rows="6" required placeholder="برای ثبت کسب‌وکار: نام مرکز، آدرس، تلفن، ساعت کاری، حوزه تخصصی و آیدی اینستاگرام را بنویسید."></textarea>
          </label>
          <button class="btn btn--brand" type="submit"><Icon name="lucide:send" />ارسال پیام</button>
        </form>
      </div>
    </div>
  </section>

  <section class="section section--soft">
    <div class="container" style="max-width:820px">
      <div class="section-head"><h2>سؤالات متداول</h2></div>
      <FaqList items={faqs} />
    </div>
  </section>
</BaseLayout>

<script>
  const form = document.querySelector<HTMLFormElement>("form[data-mailto]");
  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const f = new FormData(form);
    const subject = `${f.get("topic")} — ${f.get("name")}`;
    const body = `${f.get("message")}\n\nنام: ${f.get("name")}\nتلفن: ${f.get("phone") || "-"}`;
    location.href = `mailto:${form.dataset.mailto}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(body)}`;
  });
</script>

<style>
  .contact { display: grid; gap: 24px; }
  @media (min-width: 1024px) { .contact { grid-template-columns: 1fr 1.4fr; align-items: start; } }
  .contact__cards { display: grid; gap: 12px; }
  .c-card { display: grid; grid-template-columns: auto 1fr; column-gap: 12px; align-items: center; background: #fff; border: 1px solid var(--line); border-radius: var(--radius); padding: 14px 16px; box-shadow: var(--shadow-sm); }
  .c-card :global(svg) { grid-row: span 2; width: 40px; height: 40px; padding: 9px; border-radius: 50%; background: var(--brand-50); color: var(--brand-600); }
  .c-card span { font-size: .8rem; color: var(--muted); }
  .c-card strong { font-size: .95rem; line-height: 1.8; }
  a.c-card:hover { border-color: var(--brand-100); }
  .contact__form { padding: 24px; scroll-margin-top: calc(var(--header-h) + 16px); }
  .contact__form h2 { font-size: 1.25rem; }
  .contact__form form { display: grid; gap: 14px; margin-top: 16px; }
  .f-row { display: grid; gap: 14px; }
  @media (min-width: 640px) { .f-row { grid-template-columns: 1fr 1fr; } }
  label { display: grid; gap: 6px; font-size: .88rem; font-weight: 700; color: var(--ink-2); }
  input, select, textarea {
    font: inherit; font-weight: 400; padding: 10px 14px; border-radius: var(--radius-sm); border: 1px solid var(--line);
    background: var(--bg-softer); color: var(--ink); width: 100%;
  }
  input:focus, select:focus, textarea:focus { outline: 0; border-color: var(--brand); box-shadow: 0 0 0 3px var(--brand-50); background: #fff; }
  form .btn { justify-self: start; }
</style>
