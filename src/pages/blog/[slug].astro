---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  return posts.map((p) => ({ params: { slug: p.slug } })); 
}

const { slug } = Astro.params;

const posts = await getCollection("posts", ({ slug: s }) => s === slug);
const post = posts[0];
if (!post) throw new Error(`Post not found for slug: ${slug}`);

const { Content } = await post.render(); 

const jsonLd = [
  ...(post.data.schemaGraph ? [post.data.schemaGraph] : []),
  ...(post.data.schemaFAQ ? [post.data.schemaFAQ] : []),
  ...(post.data.schemaBreadcrumb ? [post.data.schemaBreadcrumb] : []),
  ...(post.data.schemaExtras ?? []),
];

const canonical = `https://kojahast.com/blog/${post.slug}/`;

const seo = {
  title: post.data.title,
  description: post.data.description,
  canonical,
  robots: post.data.robots,
  og: {
    ...post.data.og,
    url: canonical,
    siteName: "کجا هست",
  },
  twitter: post.data.twitter,
  jsonLd,
};
---

<BaseLayout seo={seo}>
  <main class="mx-auto max-w-3xl px-4 py-10">
    <article>
      <h1 class="text-2xl font-black leading-10">{post.data.title}</h1>
      <div class="mt-3 text-sm text-zinc-600">
        <a class="underline" href={`/blog/category/${post.data.category.slug}/`}>
          {post.data.category.name}
        </a>
      </div>

      <div class="prose prose-zinc mt-8 max-w-none leading-8">
        <Content />  {/* ✅ */}
      </div>
    </article>
  </main>
</BaseLayout>
