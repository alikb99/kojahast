---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("posts");
  const categorySlugs = Array.from(new Set(posts.map((p) => p.data.category.slug)));
  return categorySlugs.map((category) => ({ params: { category } }));
}

const { category } = Astro.params;

const posts = await getCollection("posts", ({ data }) => data.category.slug === category);

// مرتب‌سازی (جدیدترین اول)
const sorted = posts
  .slice()
  .sort((a, b) => (b.data.publishedTime ?? "").localeCompare(a.data.publishedTime ?? ""));

const categoryName = sorted[0]?.data.category.name ?? category;

// canonical دسته
const canonical = `https://kojahast.com/blog/category/${category}/`;

const seo = {
  title: `${categoryName} | کجا هست`,
  description: `مقالات دسته‌بندی ${categoryName} در کجا هست.`,
  canonical,
  robots: "index,follow,max-snippet:-1,max-video-preview:-1,max-image-preview:large",
  og: {
    type: "website",
    title: `${categoryName} | کجا هست`,
    description: `مقالات دسته‌بندی ${categoryName} در کجا هست.`,
    siteName: "کجا هست",
    locale: "fa_IR",
    url: canonical,
  },
  twitter: {
    card: "summary_large_image",
    title: `${categoryName} | کجا هست`,
    description: `مقالات دسته‌بندی ${categoryName} در کجا هست.`,
  },
  jsonLd: [
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      itemListElement: [
        { "@type": "ListItem", position: 1, item: { "@id": "https://kojahast.com/", name: "خانه" } },
        { "@type": "ListItem", position: 2, item: { "@id": "https://kojahast.com/blog/", name: "مقالات" } },
        { "@type": "ListItem", position: 3, item: { "@id": canonical, name: categoryName } },
      ],
    },
  ],
};

// یک کمک کوچک برای نمایش تاریخ (اگر خواستی)
function formatPersianDate(isoLike?: string) {
  if (!isoLike) return "";
  // اگر تاریخ به شکل ISO باشد، نمایش ساده می‌دهیم (می‌تونی بعداً حرفه‌ای‌ترش کنی)
  const d = new Date(isoLike);
  if (Number.isNaN(d.getTime())) return "";
  return d.toLocaleDateString("fa-IR", { year: "numeric", month: "long", day: "numeric" });
}
---

<BaseLayout seo={seo}>
  <main class="mx-auto max-w-6xl px-4 py-10">
    <header class="rounded-2xl border border-zinc-200 bg-zinc-50 p-6">
      <h1 class="text-2xl font-black leading-10">{categoryName}</h1>
      <p class="mt-2 leading-8 text-zinc-700">
        {`آخرین مقالات و معرفی مراکز مرتبط با «${categoryName}»`}
      </p>
    </header>

    <section class="mt-8">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
        {sorted.map((p) => {
          const href = `/blog/${p.slug}/`;
          const img = p.data.og?.image;
          const imgAlt = p.data.og?.imageAlt ?? p.data.title;
          const dateText = formatPersianDate(p.data.publishedTime);

          return (
            <article class="group relative overflow-hidden rounded-2xl border border-zinc-200 bg-white hover:bg-zinc-50">
              {/* کل کارت کلیک‌پذیر */}
              <a href={href} class="absolute inset-0 z-10" aria-label={p.data.title}></a>

              {img ? (
                <div class="h-44 w-full overflow-hidden bg-zinc-100">
                  <img
                    src={img}
                    alt={imgAlt}
                    loading="lazy"
                    class="h-full w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
                  />
                </div>
              ) : null}

              <div class="p-4">
                <h2 class="font-bold leading-8">{p.data.title}</h2>

                <p class="mt-2 text-sm leading-7 text-zinc-700">
                  {p.data.description}
                </p>

                {dateText ? (
                  <p class="mt-3 text-xs text-zinc-500">{dateText}</p>
                ) : null}

                {/* لینک نمایشی (در کنار کلیک کل کارت) */}
                <div class="mt-4 inline-flex items-center gap-2 text-sm text-zinc-800">
                  <span class="underline">مشاهده مقاله</span>
                </div>
              </div>
            </article>
          );
        })}
      </div>
    </section>
  </main>
</BaseLayout>
