---
import { SITE } from "../data/site";

/** light: برای پس زمینه تیره (فوتر) — نماد ذره بین + نوشته سفید، چون «هست» در لوگوی اصلی مشکی است */
type Props = { light?: boolean };
const { light = false } = Astro.props;
---

{
  light ? (
    <span class="logo logo--light">
      <img class="logo__mark" src="/favicon-96x96.png" alt="" width="40" height="40" decoding="async" />
      <span class="logo__text">
        کجا<span class="logo__accent">هست</span>
      </span>
    </span>
  ) : (
    <span class="logo">
      <img class="logo__wide" src={SITE.logoWide} alt={`لوگوی ${SITE.name}`} width="107" height="50" decoding="async" fetchpriority="high" />
    </span>
  )
}

<style>
  .logo { display: inline-flex; align-items: center; gap: 8px; }
  .logo__wide { height: 50px; width: auto; display: block; }
  .logo__mark { width: 40px; height: 40px; flex: none; }
  .logo__text { font-weight: 900; font-size: 1.3rem; letter-spacing: -0.3px; line-height: 1; color: #fff; }
  .logo__accent { color: var(--accent); margin-right: 3px; }
  @media (max-width: 560px) { .logo__wide { height: 42px; } }
</style>
