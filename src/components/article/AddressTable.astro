---
type Row = { name: string; phone: string; address: string; href?: string };
type Props = { title?: string; rows: Row[] };

const { title = "آدرس و تلفن مراکز", rows } = Astro.props;
---

<section class="mt-10">
  <h2 class="text-xl font-black">{title}</h2>

  <div class="mt-4 overflow-hidden rounded-2xl border border-zinc-200">
    <div class="overflow-x-auto">
      <table class="min-w-full text-sm">
        <thead class="bg-zinc-50 text-zinc-700">
          <tr>
            <th class="px-4 py-3 text-right font-bold">نام مرکز</th>
            <th class="px-4 py-3 text-right font-bold">شماره تماس</th>
            <th class="px-4 py-3 text-right font-bold">آدرس</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-zinc-200">
          {rows.map((r) => (
            <tr class="hover:bg-zinc-50">
              <td class="px-4 py-3 font-semibold">
                {r.href ? <a class="underline" href={r.href}>{r.name}</a> : r.name}
              </td>
              <td class="px-4 py-3" dir="ltr">{r.phone}</td>
              <td class="px-4 py-3 leading-7 text-zinc-700">{r.address}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </div>
</section>
