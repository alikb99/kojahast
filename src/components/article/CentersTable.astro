---
import { Icon } from "astro-icon/components";
import type { Post } from "../../lib/posts";
import { fa, phoneDisplay, telHref } from "../../lib/utils";

type Props = { centers: Post["data"]["centers"]; title: string };
const { centers, title } = Astro.props;
---

<section class="ctable" aria-labelledby="ctable-title">
  <div class="ctable__head">
    <h2 id="ctable-title"><Icon name="lucide:list" />{title}</h2>
    <span class="chip chip--accent">{fa(centers.length)} مرکز بررسی شده</span>
  </div>
  <div class="ctable__scroll">
    <table>
      <thead>
        <tr>
          <th scope="col">#</th>
          <th scope="col">نام مرکز</th>
          <th scope="col">منطقه</th>
          <th scope="col">تلفن</th>
          <th scope="col">ساعت کاری</th>
          <th scope="col">مناسب برای</th>
        </tr>
      </thead>
      <tbody>
        {centers.map((c, i) => (
          <tr>
            <td class="ctable__n">{fa(i + 1)}</td>
            <th scope="row" data-label="نام مرکز"><a href={`#${c.id}`}>{c.name}</a></th>
            <td data-label="منطقه">{c.area ?? "—"}</td>
            <td data-label="تلفن">
              {c.phones.length ? <a href={telHref(c.phones[0])} class="ltr ctable__tel">{phoneDisplay(c.phones[0])}</a> : "—"}
            </td>
            <td data-label="ساعت کاری">{c.hours ?? "تماس بگیرید"}</td>
            <td data-label="مناسب برای">{c.bestFor ?? "—"}</td>
          </tr>
        ))}
      </tbody>
    </table>
  </div>
</section>

<style>
  .ctable { background: #fff; border: 1px solid var(--line); border-radius: var(--radius); box-shadow: var(--shadow-sm); overflow: hidden; }
  .ctable__head { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 8px; padding: 14px 18px; background: var(--brand-50); border-bottom: 1px solid var(--brand-100); }
  .ctable__head h2 { font-size: 1.05rem; display: flex; align-items: center; gap: 8px; }
  .ctable__head h2 svg { width: 20px; height: 20px; color: var(--brand-600); }
  table { width: 100%; border-collapse: collapse; font-size: .86rem; }
  th, td { padding: 11px 12px; text-align: right; vertical-align: top; line-height: 1.8; }
  thead th { background: var(--bg-softer); color: var(--muted); font-weight: 700; font-size: .78rem; border-bottom: 1px solid var(--line); white-space: nowrap; }
  tbody tr { border-bottom: 1px solid var(--line-2); }
  tbody tr:last-child { border-bottom: 0; }
  tbody tr:hover { background: var(--bg-softer); }
  tbody th a { color: var(--brand-700); font-weight: 800; }
  tbody th a:hover { text-decoration: underline; }
  .ctable__n { color: var(--muted); font-weight: 700; width: 34px; }
  .ctable__tel { font-weight: 700; white-space: nowrap; }
  .ctable__tel:hover { color: var(--brand-700); }

  /* موبایل: هر ردیف یک کارت */
  @media (max-width: 719px) {
    thead { display: none; }
    table, tbody, tr, td, th { display: block; }
    tbody tr { padding: 12px 16px; display: grid; grid-template-columns: auto 1fr; column-gap: 10px; }
    .ctable__n { grid-row: span 5; width: auto; padding: 2px 0; }
    tbody th, tbody td:not(.ctable__n) { padding: 2px 0; }
    tbody td:not(.ctable__n)::before { content: attr(data-label) ": "; color: var(--muted); font-size: .78rem; }
  }
</style>
