---
type QA = { q: string; a: string };
type Props = { title?: string; items: QA[] };
const { title = "سوالات متداول", items } = Astro.props;
---

<section class="mt-12">
  <h2 class="text-xl font-black">{title}</h2>

  <div class="mt-4 space-y-4">
    {items.map((it) => (
      <details class="rounded-2xl border border-zinc-200 bg-white p-4">
        <summary class="cursor-pointer font-bold">{it.q}</summary>
        <p class="mt-3 leading-8 text-zinc-700">{it.a}</p>
      </details>
    ))}
  </div>
</section>
